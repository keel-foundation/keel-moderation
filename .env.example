# Local only. Do not use a production secret here.
KEELTUBE_LEDGER_PATH=data/ledger.jsonl
KEELTUBE_STATE_DB=data/state.sqlite3
KEELTUBE_CORS_ORIGINS=http://localhost:3000
KEELTUBE_RATE_LIMIT=30

# OIDC mode. This is the preferred mode and takes precedence over role tokens.
KEELTUBE_OIDC_ISSUER=keel-core
KEELTUBE_OIDC_AUDIENCE=keel-moderation
KEELTUBE_OIDC_HMAC_SECRET=local-dev-moderation-claims-secret
KEELTUBE_OIDC_ALGORITHMS=HS256
KEELTUBE_OIDC_SUBJECT_CLAIM=sub
KEELTUBE_OIDC_ROLE_CLAIM=role
KEELTUBE_OIDC_CHANNEL_CLAIM=channel_ids
KEELTUBE_OIDC_LEEWAY_SECONDS=60
KEELTUBE_OIDC_JWKS_CACHE_SECONDS=300

# Explicit role tokens for direct moderation API tests. OIDC mode takes
# precedence while KEELTUBE_OIDC_ISSUER is set.
KEELTUBE_CREATOR_TOKEN=local-dev-creator-token
KEELTUBE_MODERATOR_TOKEN=local-dev-moderator-token
KEELTUBE_APPEALS_TOKEN=local-dev-appeals-token

# Role-token channel claims. OIDC mode uses the channel_ids claim instead.
# KEELTUBE_CREATOR_CHANNEL_MAP={"creator:demo":["ch_demo"]}
