# Local only. Do not use a production secret here.
TUBEKEEL_LEDGER_PATH=data/ledger.jsonl
TUBEKEEL_STATE_DB=data/state.sqlite3
TUBEKEEL_CORS_ORIGINS=http://localhost:3000
TUBEKEEL_RATE_LIMIT=30

# Legacy single-token demo mode. One token simulates creator, moderator, and appeals reviewer.
# TUBEKEEL_DEMO_TOKEN=

# Role-enforced mode. Set all three to distinct values to enforce creator/moderator/appeals
# separation and reviewer independence.
# TUBEKEEL_CREATOR_TOKEN=
# TUBEKEEL_MODERATOR_TOKEN=
# TUBEKEEL_APPEALS_TOKEN=
